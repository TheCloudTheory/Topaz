{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namespaceName": {
      "type": "string",
      "defaultValue": "topaz-egns",
      "metadata": {
        "description": "Name of the Event Grid Namespace"
      }
    },
    "topicName": {
      "type": "string",
      "defaultValue": "topic1",
      "metadata": {
        "description": "Name of the Event Grid custom topic"
      }
    },
    "topicSubscriptionName": {
      "type": "string",
      "defaultValue": "sub1",
      "metadata": {
        "description": "Name of the custom topic event subscription"
      }
    },
    "systemTopicName": {
      "type": "string",
      "defaultValue": "systemtopic1",
      "metadata": {
        "description": "Name of the Event Grid system topic"
      }
    },
    "systemTopicSource": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the source resource for the system topic"
      }
    },
    "systemTopicSubscriptionName": {
      "type": "string",
      "defaultValue": "systemsub1",
      "metadata": {
        "description": "Name of the system topic event subscription"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.EventGrid/namespaces",
      "apiVersion": "2024-06-01-preview",
      "name": "[parameters('namespaceName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "capacity": 1
      },
      "properties": {
        "topicSpacesConfiguration": {
          "state": "Disabled"
        },
        "isZoneRedundant": true,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.EventGrid/topics",
      "apiVersion": "2022-06-15",
      "name": "[parameters('topicName')]",
      "location": "[parameters('location')]",
      "properties": {
        "inputSchema": "EventGridSchema"
      }
    },
    {
      "type": "Microsoft.EventGrid/topics/providers/eventSubscriptions",
      "apiVersion": "2022-06-15",
      "name": "[format('{0}/Microsoft.EventGrid/{1}', parameters('topicName'), parameters('topicSubscriptionName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.EventGrid/topics', parameters('topicName'))]"
      ],
      "properties": {
        "destination": {
          "endpointType": "StorageQueue",
          "properties": {
            "resourceId": "[parameters('systemTopicSource')]",
            "queueName": "eventgrid-queue"
          }
        },
        "eventDeliverySchema": "EventGridSchema"
      }
    },
    {
      "type": "Microsoft.EventGrid/systemTopics",
      "apiVersion": "2022-06-15",
      "name": "[parameters('systemTopicName')]",
      "location": "[parameters('location')]",
      "properties": {
        "source": "[parameters('systemTopicSource')]",
        "topicType": "Microsoft.Storage.StorageAccounts"
      }
    },
    {
      "type": "Microsoft.EventGrid/systemTopics/eventSubscriptions",
      "apiVersion": "2022-06-15",
      "name": "[format('{0}/{1}', parameters('systemTopicName'), parameters('systemTopicSubscriptionName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.EventGrid/systemTopics', parameters('systemTopicName'))]"
      ],
      "properties": {
        "destination": {
          "endpointType": "StorageQueue",
          "properties": {
            "resourceId": "[parameters('systemTopicSource')]",
            "queueName": "eventgrid-queue"
          }
        },
        "eventDeliverySchema": "EventGridSchema"
      }
    }
  ],
  "outputs": {
    "namespaceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.EventGrid/namespaces', parameters('namespaceName'))]"
    },
    "namespaceName": {
      "type": "string",
      "value": "[parameters('namespaceName')]"
    },
    "topicId": {
      "type": "string",
      "value": "[resourceId('Microsoft.EventGrid/topics', parameters('topicName'))]"
    },
    "topicName": {
      "type": "string",
      "value": "[parameters('topicName')]"
    },
    "systemTopicId": {
      "type": "string",
      "value": "[resourceId('Microsoft.EventGrid/systemTopics', parameters('systemTopicName'))]"
    },
    "systemTopicName": {
      "type": "string",
      "value": "[parameters('systemTopicName')]"
    }
  }
}
